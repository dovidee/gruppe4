# This file is a placeholder for environment variables required to run this project.

# Required — Sanity project connection
NEXT_PUBLIC_SANITY_PROJECT_ID=4t5fwbp6
NEXT_PUBLIC_SANITY_DATASET=production

# Required for /api/revalidate — must match the secret set on the Sanity
# webhook (sanity.io/manage → API → Webhooks). Server-only, no NEXT_PUBLIC_ prefix.
SANITY_REVALIDATE_SECRET=generate-a-random-string

# Required for /api/contact — the Discord webhook the contact form posts to
# (Discord -> Server Settings -> Integrations -> Webhooks). Server-only, no
# NEXT_PUBLIC_ prefix, so the URL never reaches the browser bundle.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

